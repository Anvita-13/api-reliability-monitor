# Copy to ".env" for local development:  copy .env.example .env
# On AWS, set the same variables on the server (systemd EnvironmentFile, Parameter Store,
# Secrets Manager). Never commit the real .env.

# ---- application ----
APP_ENV=development
# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
# Required when APP_ENV=production. Every server behind a load balancer must use the SAME value.
SECRET_KEY=
SESSION_COOKIE_SECURE=false

# ---- database (MySQL locally, Amazon RDS on AWS) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=api_monitor
DB_USER=root
DB_PASSWORD=
# DB_SSL_CA=/etc/ssl/certs/global-bundle.pem   # RDS CA bundle, to encrypt DB traffic
# DATABASE_URL=                                # optional full SQLAlchemy URL (overrides DB_*)

# ---- monitoring rules ----
DEFAULT_TIMEOUT_SECONDS=5
DEFAULT_INTERVAL_SECONDS=60
DEFAULT_FAILURE_THRESHOLD=3
MIN_INTERVAL_SECONDS=10
RETENTION_DAYS=30
# SSRF protection. KEEP false on any real server. Set true ONLY for local development so you
# can monitor a mock server on localhost.
ALLOW_PRIVATE_TARGETS=true

# ---- worker ----
WORKER_CONCURRENCY=10
RUN_WORKER_IN_API=false          # true = run the worker inside the API process (single-process dev)

# ---- notifications ----
NOTIFICATION_BACKEND=console     # console | sns
# SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:monitor-alerts
# AWS_REGION=ap-south-1

# ---- exported reports ----
STORAGE_BACKEND=local            # local | s3
EXPORTS_DIR=exports
# S3_BUCKET=my-monitor-bucket
# S3_PREFIX=monitor

# ---- operational metrics ----
METRICS_BACKEND=none             # none | cloudwatch  (cloudwatch needs AWS_REGION and the cloudwatch:PutMetricData permission)
# METRICS_NAMESPACE=Monitor
